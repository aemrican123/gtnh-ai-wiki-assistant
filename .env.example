OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GTNH_DATA_DIR=data
GTNH_REQUEST_INTERVAL=2
GTNH_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GTNH_CONTEXT_TOKENS=5000
GTNH_HISTORY_TOKENS=800
GTNH_OUTPUT_TOKENS=1000
GTNH_RETRIEVAL_LIMIT=8
GTNH_SEARCH_ROUNDS=2
