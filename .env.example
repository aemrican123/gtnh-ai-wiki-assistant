# Everything runs locally. No API key or paid service is needed.
GTNH_DATA_DIR=data
GTNH_REQUEST_INTERVAL=2
GTNH_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Local language model served by Ollama (https://ollama.com)
GTNH_OLLAMA_HOST=http://127.0.0.1:11434
GTNH_LLM_MODEL=qwen3.5:9b
# Context window given to the model. Larger values use more GPU memory; 8192 suits an 8 GB GPU.
GTNH_NUM_CTX=8192
GTNH_TEMPERATURE=0.2
# How long Ollama keeps the model in GPU memory after the last question.
GTNH_KEEP_ALIVE=30m
GTNH_LLM_TIMEOUT=180
GTNH_THINK=false

# Retrieval and context budgets (tokens)
GTNH_CONTEXT_TOKENS=5000
GTNH_HISTORY_TOKENS=800
GTNH_OUTPUT_TOKENS=1000
GTNH_RETRIEVAL_LIMIT=8
GTNH_SEARCH_ROUNDS=2
